// ─── Prisma Schema (devlink-backendjs) ────────────────────────────────────────
// Only the models needed: User (auth), HackathonTeam, HackathonMember

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  firebaseUid String?  @unique
  email       String   @unique
  username    String?  @unique
  name        String?
  firstName   String?
  lastName    String?
  provider    String?  @default("firebase")
  role        String   @default("Fullstack Developer")
  githubUrl   String?
  avatar      String?
  bio         String?
  skills      String?  // JSON string array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

// ─── Hackathon Registration ────────────────────────────────────────────────────

model HackathonTeam {
  id            String   @id @default(uuid())
  teamName      String
  leaderName    String
  leaderEmail   String
  leaderPhone   String
  leaderCollege String
  status        String   @default("pending") // pending | registered
  createdAt     DateTime @default(now())

  members       HackathonMember[]

  @@map("hackathon_teams")
}

model HackathonMember {
  id          String   @id @default(uuid())
  teamId      String
  team        HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  phone       String?
  college     String?
  inviteToken String   @unique @default(uuid())
  status      String   @default("pending") // pending | verified
  invitedAt   DateTime @default(now())
  verifiedAt  DateTime?

  @@map("hackathon_members")
}
