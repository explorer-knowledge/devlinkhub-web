{
  "name": "devlink-hackathon-backend",
  "version": "1.0.0",
  "description": "DevLink Hackathon Registration Backend — Cashfree payment-gated registration",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "redis:flush": "node scripts/flushRedis.js",
    "email:test": "node scripts/testEmail.js",
    "get:data": "node scripts/printData.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "axios": "^1.16.1",
    "cashfree-pg": "^6.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.11.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0"
  },
  "devDependencies": {
    "prisma": "^5.10.2"
  }
}
