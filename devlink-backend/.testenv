# Database
DATABASE_URL=""

# Redis
REDIS_URL=""

# Cache TTLs (seconds)
CACHE_TTL_EVENTS=300
CACHE_TTL_PROJECTS=300
CACHE_TTL_STARTUPS=300
CACHE_TTL_BUILDERS=600
CACHE_TTL_PROFILE=600

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# JWT
JWT_SECRET=""

# Server
PORT=10000
NODE_ENV=development
BACKEND_URL="http://localhost:10000"

# Frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL="http://localhost:3000"

# Session secret (used by express-session for OAuth flows)
SESSION_SECRET="devlink_session_secret_2026"

# Google OAuth — get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — get from https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"